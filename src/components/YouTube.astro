---
// DSGVO-safe two-click YouTube embed.
// Renders a local facade; loads youtube-nocookie.com only after the user clicks.
interface Props {
  id: string;      // YouTube video ID
  title: string;
}
const { id, title } = Astro.props;
---
<div class="yt-facade imgbox" data-yt-id={id} style="aspect-ratio:16/9; position:relative; background:var(--bone-2); cursor:pointer;">
  <div class="placeholder" style="position:absolute; inset:0;">
    <span class="mono" style="font-size:11px;">VIDEO · YOUTUBE</span>
  </div>
  <button type="button" class="yt-play" aria-label={`Play video: ${title}`}>
    ▶ PLAY
  </button>
  <p class="yt-hint mono">
    Loads from youtube-nocookie.com on play. Google's privacy policy applies.
  </p>
</div>

<style>
  .yt-play {
    position: absolute; inset: 0; margin: auto;
    width: 140px; height: 48px;
    background: var(--accent); color: var(--accent-ink);
    border: 0; cursor: pointer;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em;
    z-index: 2;
  }
  .yt-play:hover { background: var(--ink); color: var(--bone); }
  .yt-play:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .yt-hint {
    position: absolute; bottom: 10px; left: 12px; right: 12px;
    font-size: 10px; color: var(--ink-mute); z-index: 2; margin: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach((el) => {
    el.addEventListener('click', () => {
      const id = el.dataset.ytId;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
      el.innerHTML = '';
      el.appendChild(iframe);
      el.style.cursor = 'default';
    }, { once: true });
  });
</script>
