---
export interface Props {
  images?: { src: string; alt?: string }[];
  ratio?: string;
  video?: string;
  videoPoster?: string;
}
const { images = [], ratio = '4/3', video, videoPoster } = Astro.props;
const items = images.length ? images : [
  { src: '', alt: 'STUDIO' }, { src: '', alt: 'RIG' }, { src: '', alt: 'DESK' },
];
const id = 'g' + Math.random().toString(36).slice(2, 8);
---
<div class="gal" data-gal={id}>
  <div class="gal-viewport">
    <div class="gal-track">
      {video && (
        <div class="gal-item" style={`aspect-ratio:${ratio}`}>
          <video class="gal-video" src={video} poster={videoPoster} autoplay muted loop playsinline data-i="0"></video>
        </div>
      )}
      {items.map((im, i) => (
        <div class="gal-item" style={`aspect-ratio:${ratio}`}>
          {im.src
            ? <img src={im.src} alt={im.alt || ''} loading="lazy" data-full={im.src} data-i={i + (video ? 1 : 0)} />
            : <div class="placeholder gal-ph" data-i={i + (video ? 1 : 0)}><span class="mono">{im.alt}</span></div>}
        </div>
      ))}
    </div>
  </div>
  {(items.length + (video ? 1 : 0)) > 1 && (
    <div class="gal-controls">
      <button type="button" class="gal-btn" data-dir="-1" aria-label="Previous">←</button>
      <span class="mono gal-count"><span class="gal-cur">1</span> / {items.length + (video ? 1 : 0)}</span>
      <button type="button" class="gal-btn" data-dir="1" aria-label="Next">→</button>
    </div>
  )}
</div>

<dialog class="gal-lb" data-lb={id}>
  <button type="button" class="lb-close" aria-label="Close">✕</button>
  <button type="button" class="lb-nav lb-prev" aria-label="Previous">←</button>
  <img class="lb-img" src="" alt="" />
  <button type="button" class="lb-nav lb-next" aria-label="Next">→</button>
</dialog>

<style>
  .gal-viewport { overflow: hidden; }
  .gal-track { display: flex; transition: transform .35s ease; }
  .gal-item { flex: 0 0 100%; position: relative; }
  .gal-item img { width: 100%; height: 100%; object-fit: cover; display: block; cursor: zoom-in; }
  .gal-video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gal-ph { position: absolute; inset: 0; }
  .gal-controls {
    display: flex; align-items: center; gap: 16px;
    padding: 12px 0 0; justify-content: flex-end;
  }
  .gal-btn {
    width: 36px; height: 36px; border: 1px solid var(--rule);
    background: transparent; color: var(--ink); cursor: pointer;
    font-family: var(--font-mono); transition: border-color .15s, color .15s;
  }
  .gal-btn:hover { border-color: var(--accent); color: var(--accent); }
  .gal-count { color: var(--ink-mute); font-size: 12px; }

  .gal-lb {
    border: 0; padding: 0; background: transparent;
    max-width: 100vw; max-height: 100vh; width: 100%; height: 100%;
  }
  .gal-lb::backdrop { background: rgba(10,10,9,.94); }
  .gal-lb[open] { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .lb-img { max-width: 88vw; max-height: 88vh; object-fit: contain; }
  .lb-close {
    position: fixed; top: 20px; right: 24px;
    background: transparent; border: 1px solid rgba(228,226,221,.4); color: #e4e2dd;
    width: 40px; height: 40px; cursor: pointer; font-family: var(--font-mono);
  }
  .lb-nav {
    background: transparent; border: 1px solid rgba(228,226,221,.4); color: #e4e2dd;
    width: 44px; height: 44px; cursor: pointer; font-family: var(--font-mono); flex: 0 0 auto;
  }
  .lb-close:hover, .lb-nav:hover { border-color: var(--accent); color: var(--accent); }
</style>

<script>
  document.querySelectorAll('.gal').forEach((gal) => {
    const id = gal.dataset.gal;
    const track = gal.querySelector('.gal-track');
    const items = gal.querySelectorAll('.gal-item');
    const cur = gal.querySelector('.gal-cur');
    let i = 0;
    const vid = gal.querySelector('.gal-video');
    const go = (n) => {
      i = (n + items.length) % items.length;
      track.style.transform = `translateX(-${i * 100}%)`;
      if (cur) cur.textContent = String(i + 1);
      if (vid) {
        if (i === 0) { vid.currentTime = 0; vid.play(); }
        else { vid.pause(); }
      }
    };
    gal.querySelectorAll('.gal-btn').forEach((b) =>
      b.addEventListener('click', () => go(i + Number(b.dataset.dir)))
    );

    const lb = document.querySelector(`.gal-lb[data-lb="${id}"]`);
    if (!lb) return;
    const lbImg = lb.querySelector('.lb-img');
    const sources = Array.from(gal.querySelectorAll('img[data-full]'));
    if (!sources.length) return;
    let li = 0;
    const openAt = (n) => {
      li = (n + sources.length) % sources.length;
      lbImg.src = sources[li].dataset.full;
      lbImg.alt = sources[li].alt || '';
      if (!lb.open) lb.showModal();
    };
    sources.forEach((img, n) => img.addEventListener('click', () => openAt(n)));
    lb.querySelector('.lb-prev').addEventListener('click', () => openAt(li - 1));
    lb.querySelector('.lb-next').addEventListener('click', () => openAt(li + 1));
    lb.querySelector('.lb-close').addEventListener('click', () => lb.close());
    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') openAt(li - 1);
      if (e.key === 'ArrowRight') openAt(li + 1);
    });
  });
</script>
