---
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import { getCollection, render } from 'astro:content';
import productsData from '../../data/products.json';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const relProduct = d.relatedProduct
  ? productsData.products.find((p) => p.id === d.relatedProduct)
  : null;

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': d.category === 'tutorial' ? 'TechArticle' : 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  inLanguage: 'en',
  author: { '@id': 'https://andreasroet.de/#person' },
  mainEntityOfPage: `https://andreasroet.de/blog/${post.id}`,
};
if (d.youtube) {
  articleLd.video = {
    '@type': 'VideoObject',
    name: d.title,
    description: d.description,
    uploadDate: d.date.toISOString(),
    embedUrl: `https://www.youtube-nocookie.com/embed/${d.youtube}`,
    thumbnailUrl: `https://i.ytimg.com/vi/${d.youtube}/hqdefault.jpg`,
  };
}
---
<Base title={`${d.title} | Andreas Roet`} description={d.description} activeNav="blog" jsonLd={articleLd} ogImage={d.youtube ? `https://i.ytimg.com/vi/${d.youtube}/maxresdefault.jpg` : undefined}>
  <div class="page app">
    <article style="max-width: 860px; margin: 0 auto; padding: 48px 0 72px;">
      <div class="eyebrow" style="margin-bottom: 16px;">
        {d.category === 'tutorial' ? 'Tutorial' : 'Article'}{d.topic ? ` · ${d.topic}` : ''}
      </div>
      <h1 style="font-size: clamp(36px, 5vw, 64px); margin-bottom: 20px;">{d.title}</h1>
      <div class="mono" style="color:var(--ink-mute); margin-bottom: 40px;">
        {d.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
        {d.duration ? ` · ${d.duration}` : ''}
      </div>

      {d.youtube && (
        <div style="margin-bottom: 40px;">
          <YouTube id={d.youtube} title={d.title} />
        </div>
      )}

      <div class="prose">
        <Content />
      </div>
    </article>

    <script is:inline>
      (() => {
        const fmt = (s) => {
          if (!isFinite(s)) return '0:00';
          const m = Math.floor(s / 60), sec = Math.floor(s % 60);
          return m + ':' + String(sec).padStart(2, '0');
        };
        document.querySelectorAll('.audio-player').forEach((ap) => {
          const audio = ap.querySelector('audio');
          const btn = ap.querySelector('.ap-btn');
          const fill = ap.querySelector('.ap-fill');
          const track = ap.querySelector('.ap-track');
          const time = ap.querySelector('.ap-time');
          if (!audio || !btn) return;
          const setIcon = () => { btn.textContent = audio.paused ? '\u25B6' : '\u25A0'; };
          btn.addEventListener('click', () => {
            if (audio.paused) {
              document.querySelectorAll('.audio-player audio').forEach((a) => { if (a !== audio) a.pause(); });
              audio.play();
            } else { audio.pause(); }
          });
          audio.addEventListener('play', setIcon);
          audio.addEventListener('pause', setIcon);
          audio.addEventListener('ended', () => { audio.currentTime = 0; setIcon(); });
          audio.addEventListener('loadedmetadata', () => { if (time) time.textContent = '0:00 / ' + fmt(audio.duration); });
          audio.addEventListener('timeupdate', () => {
            const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
            if (fill) fill.style.right = (100 - pct) + '%';
            if (time) time.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
          });
          if (track) track.addEventListener('click', (e) => {
            const r = track.getBoundingClientRect();
            audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
          });
          setIcon();
        });
      })();
    </script>

    {relProduct && (
      <aside class="post-product">
        <a href={relProduct.url} class="pp-link">
          {relProduct.cover && <img src={relProduct.cover} alt={relProduct.title} class="pp-thumb" loading="lazy" />}
          <div class="pp-body">
            <div class="mono pp-eyebrow">From the shop</div>
            <div class="pp-title">{relProduct.title}</div>
            <div class="pp-sub">{relProduct.sub}</div>
          </div>
          <div class="pp-cta mono">{relProduct.price} <span class="arrow">→</span></div>
        </a>
      </aside>
    )}

    <nav class="post-nav" aria-label="More posts">
      {older ? (
        <a class="pn pn-prev" href={`/blog/${older.id}`}>
          <span class="mono pn-label">← Previous</span>
          <span class="pn-title">{older.data.title}</span>
        </a>
      ) : <span class="pn pn-empty"></span>}
      {newer ? (
        <a class="pn pn-next" href={`/blog/${newer.id}`}>
          <span class="mono pn-label">Next →</span>
          <span class="pn-title">{newer.data.title}</span>
        </a>
      ) : <span class="pn pn-empty"></span>}
    </nav>
  </div>

  <style is:global>
    .prose { font-size: 17px; line-height: 1.65; color: var(--ink-soft); }
    .prose h2 { margin: 44px 0 16px; font-size: clamp(24px, 3vw, 34px); }
    .prose h3 { margin: 32px 0 12px; }
    .prose p { margin: 0 0 18px; }
    .prose a { color: var(--ink); text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
    .prose a:hover { color: var(--accent); }
    .prose code { font-family: var(--font-mono); font-size: 0.88em; background: var(--bone-2); padding: 1px 5px; }
    .prose pre { background: var(--bone-2); padding: 16px; overflow-x: auto; border: 1px solid var(--rule); }
    .prose blockquote { margin: 24px 0; padding-left: 20px; border-left: 3px solid var(--accent); color: var(--ink); }
    .prose ul, .prose ol { margin: 0 0 18px; padding-left: 24px; }
    .prose li { margin-bottom: 6px; }
    .prose img { max-width: 100%; display:block; margin: 28px 0; border: 1px solid var(--rule); }
    .prose img + em { display:block; margin-top:-20px; margin-bottom:28px; font-size:13px; color:var(--ink-mute); font-style:normal; font-family:var(--font-mono); }
    /* TL;DR block: first h2 + following ul */
    .prose > h2:first-of-type { margin-top: 0; }
    .prose > h2:first-of-type + ul {
      border-left: 3px solid var(--accent); padding: 14px 20px 14px 28px;
      list-style: none; margin-left: 0;
    }
    .prose > h2:first-of-type + ul li { margin-bottom: 10px; }

    /* Parameter box — mono, framed, with title */
    .prose .param-box {
      border: 1px solid var(--rule); margin: 28px 0; background: var(--bone-2);
    }
    .prose .param-box .param-title {
      font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--accent);
      padding: 12px 18px; border-bottom: 1px solid var(--rule);
    }
    .prose .param-box pre {
      margin: 0; padding: 16px 18px; overflow-x: auto;
      font-family: var(--font-mono); font-size: 13px; line-height: 1.7; color: var(--ink);
      white-space: pre; background: none;
    }

    /* Inline product call-out */
    .prose .callout {
      border-left: 3px solid var(--accent); background: var(--bone-2);
      padding: 18px 20px; margin: 28px 0;
      display: flex; gap: 18px; align-items: center; flex-wrap: wrap;
    }
    .prose .callout .co-text { flex: 1 1 260px; font-size: 15px; line-height: 1.5; margin: 0; }
    .prose .callout .co-text strong { display:block; font-family:var(--font-heading); text-transform:uppercase; font-size:15px; margin-bottom:4px; }
    .prose .callout a.co-btn {
      font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;
      border: 1px solid var(--accent); background: var(--accent); color: var(--accent-ink);
      padding: 10px 16px; text-decoration: none; white-space: nowrap;
    }
    .prose .callout a.co-btn:hover { background: transparent; color: var(--accent); }

    /* AI-scannable tables */
    .prose table {
      width: 100%; border-collapse: collapse; margin: 28px 0; font-size: 14px;
    }
    .prose th, .prose td {
      text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--rule); vertical-align: top;
    }
    .prose th {
      font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--ink-mute); border-bottom: 1px solid var(--rule-strong);
    }
    .prose tr:last-child td { border-bottom: 0; }

    /* Audio player — slim, borderless, stackable */
    .prose .audio-player {
      display: flex; align-items: center; gap: 14px;
      padding: 10px 0;
    }
    .prose .ap-btn {
      flex: 0 0 auto; width: 38px; height: 38px; cursor: pointer;
      border: 1px solid var(--rule); background: transparent; color: var(--ink);
      font-family: var(--font-mono); font-size: 12px; line-height: 1;
      display: flex; align-items: center; justify-content: center;
      transition: border-color .15s, color .15s;
    }
    .prose .ap-btn:hover { border-color: var(--accent); color: var(--accent); }
    .prose .ap-main { flex: 1 1 auto; min-width: 0; }
    .prose .ap-name {
      font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em;
      color: var(--ink); margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .prose .ap-track {
      position: relative; height: 3px; background: var(--rule); cursor: pointer;
    }
    .prose .ap-fill { position: absolute; inset: 0 100% 0 0; background: var(--accent); }
    .prose .ap-time {
      flex: 0 0 auto; font-family: var(--font-mono); font-size: 11px; color: var(--ink-mute);
      min-width: 76px; text-align: right;
    }
  </style>

  <style>
    .post-product { max-width:860px; margin:40px auto 0; }
    .pp-link {
      display:grid; grid-template-columns:96px 1fr auto; gap:20px; align-items:center;
      border:1px solid var(--rule); padding:16px; text-decoration:none; color:inherit;
      transition:border-color .15s, background .15s;
    }
    .pp-link:hover { border-color:var(--accent); background:color-mix(in oklab, var(--accent) 6%, transparent); }
    .pp-thumb { width:96px; height:96px; object-fit:cover; display:block; }
    .pp-eyebrow { color:var(--accent); font-size:11px; margin-bottom:6px; }
    .pp-title { font-family:var(--font-heading); text-transform:uppercase; font-size:17px; line-height:1.1; margin-bottom:4px; }
    .pp-sub { font-size:13px; color:var(--ink-soft); }
    .pp-cta { color:var(--ink); white-space:nowrap; font-size:14px; }
    @media (max-width:600px){ .pp-link{ grid-template-columns:64px 1fr; } .pp-thumb{width:64px;height:64px;} .pp-cta{grid-column:2;} }
    .post-nav {
      max-width: 860px; margin:48px auto 8px;
      display:grid; grid-template-columns:1fr 1fr; gap:16px;
      border-top:1px solid var(--rule); padding-top:24px;
    }
    .pn {
      display:flex; flex-direction:column; gap:8px;
      padding:20px; border:1px solid var(--rule);
      text-decoration:none; color:inherit;
      transition:border-color .15s, background .15s;
    }
    .pn:hover { border-color:var(--accent); background:color-mix(in oklab, var(--accent) 7%, transparent); }
    .pn-next { text-align:right; align-items:flex-end; }
    .pn-label { color:var(--ink-mute); font-size:11px; }
    .pn-title {
      font-family:var(--font-heading); font-weight:400; text-transform:uppercase;
      font-size:16px; line-height:1.15;
    }
    .pn:hover .pn-title { color:var(--accent); }
    .pn-empty { border:0; }
    @media (max-width:700px){ .post-nav{grid-template-columns:1fr;} .pn-next{text-align:left; align-items:flex-start;} }
  </style>
</Base>
