---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Mandoline — Coming Soon | Andreas Roet"
  description="Mandoline — a new creative and workflow tool for producers. Coming soon. Join the waitlist."
  activeNav="tools"
  mode="dark"
>
  <div class="page app">
    <section style="padding: 48px 0 32px; max-width: 720px;">
      <div class="eyebrow" style="margin-bottom: 16px;">Tools · Coming soon</div>
      <h1 style="margin-bottom: 28px;">Mandoline.</h1>
      <p style="font-size: 19px; line-height: 1.5; color: var(--ink-soft); margin-bottom: 24px; max-width: 560px;">
        A new creative and workflow tool for the studio. Still in development —
        more details soon.
      </p>
      <p style="font-size: 16px; line-height: 1.6; color: var(--ink-soft); margin-bottom: 32px; max-width: 560px;">
        Want to know when it drops? Join the waitlist and you'll be the first to hear.
      </p>
      <a class="btn accent" id="wl-link" href="#" style="display:inline-flex;">
        <span id="wl-text">Join the waitlist</span> <span class="arrow">→</span>
      </a>
      <script>
        (() => {
          const p = ['in','fo',String.fromCharCode(64),'andreas','roet','.','de'];
          const addr = p.join('');
          const subj = encodeURIComponent('Mandoline Waitlist');
          const link = document.getElementById('wl-link');
          if (link) link.setAttribute('href', 'mail'+'to:'+addr+'?subject='+subj);
        })();
      </script>
    </section>
  </div>
</Base>
