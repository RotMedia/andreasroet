---
import Base from '../layouts/Base.astro';
import productsData from '../data/products.json';
import testimonialsData from '../data/testimonials.json';

const products = productsData.products;
const freePacksUrl = productsData.freePacksUrl;
const featured = testimonialsData.reviews.filter((r) => r.featured).slice(0, 6);
const stars = (n) => '\u2605'.repeat(n) + '\u2606'.repeat(5 - n);

const shopLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Andreas Roet — Sample Packs & Presets',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.title,
      description: p.sub,
      url: p.url,
      ...(p.cover ? { image: p.cover } : {}),
      offers: {
        '@type': 'Offer',
        price: String(p.price).replace(/[^0-9.,]/g, ''),
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: p.checkoutUrl,
      },
      brand: { '@type': 'Brand', name: 'TechnoSupps' },
    },
  })),
};
---
<Base
  title="Shop — Dub Techno Sample Packs & Presets | Andreas Roet"
  description="Dub techno sample packs, chord presets and producer tools. Recorded with real hardware chains. Royalty-free, instant download via Gumroad."
  activeNav="shop"
  mode="dark"
  jsonLd={shopLd}
>
  <div class="page app">
    <section style="padding: 40px 0 24px;">
      <div class="eyebrow" style="margin-bottom: 16px;">Shop</div>
      <h1 style="max-width: 14ch; margin-bottom: 24px;">Tools<br />from the studio.</h1>
      <div class="row" style="gap: 40px; flex-wrap: wrap;">
        <p style="max-width: 520px; color: var(--ink-soft); font-size: 17px;">
          Ready-to-use presets and samples for dub techno and techno, made from the
          real hardware I use in my own productions. Built to drop straight into your
          workflow — minimal setup, maximum room for your own ideas.
        </p>
        <div class="mono" style="display:grid; grid-template-columns:auto auto; gap:4px 24px;">
          <span style="color:var(--ink-mute)">PACKS</span><span>{products.length}</span>
          <span style="color:var(--ink-mute)">LICENSE</span><span>Royalty-free</span>
          <span style="color:var(--ink-mute)">CHECKOUT</span><span>Gumroad</span>
        </div>
      </div>
    </section>

    <div class="row middle" style="gap:0; padding:14px 0; border-top:1px solid var(--rule-strong); border-bottom:1px solid var(--rule-strong);">
      <span class="mono" style="color:var(--ink-mute);">{products.length} ITEMS</span>
      <span class="grow"></span>
      <span class="mono" style="color:var(--ink-mute);">SECURE CHECKOUT VIA GUMROAD ↗</span>
    </div>

    <section class="shop-grid" style="padding: 32px 0 56px;">
      {products.map((p) => (
        <article>
          <a href={p.url} rel="noopener" style="text-decoration:none; color:inherit;">
            <div class="imgbox cover" style="aspect-ratio:1/1; position:relative;">
              {p.cover
                ? <img src={p.cover} alt={`${p.title} — ${p.sub}`} loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" />
                : <div class="placeholder" style="position:absolute; inset:0;"><span style="font-size:12px;">{p.cat}</span></div>}
              {p.new && (
                <span style="position:absolute; top:12px; left:12px; z-index:2; background:var(--accent); color:var(--accent-ink); padding:4px 8px; font-family:var(--font-mono); font-size:10px; letter-spacing:0.08em; border:2px solid var(--bone); box-shadow:0 0 0 1px rgba(0,0,0,.35);">NEW · OUT NOW</span>
              )}
              {p.free && (
                <span style="position:absolute; top:12px; left:12px; z-index:2; background:var(--accent); color:var(--accent-ink); padding:4px 8px; font-family:var(--font-mono); font-size:10px; letter-spacing:0.08em; border:2px solid var(--bone); box-shadow:0 0 0 1px rgba(0,0,0,.35);">FREE</span>
              )}
            </div>
          </a>
          <div class="prod-info">
            <div>
              <div class="mono" style="margin-bottom:6px;">{p.cat}</div>
              <div class="prod-title">{p.title}</div>
              <div style="margin-top:6px; font-size:13px; color:var(--ink-soft);">{p.sub}</div>
            </div>
            <div style="text-align:right; flex-shrink:0;">
              <div class="mono" style="font-size:14px;">{p.price}</div>
              <div class="mono" style="color:var(--ink-mute); margin-top:4px;">{p.fmt}</div>
            </div>
          </div>
          <a class="btn accent" href={p.checkoutUrl} rel="noopener" style="width:100%; justify-content:center;">
            {p.free ? 'Get it — free' : 'Get it — checkout on Gumroad'} <span class="arrow">→</span>
          </a>
        </article>
      ))}
    </section>

    <!-- Testimonials -->
    <section class="section">
      <div class="eyebrow" style="margin-bottom: 28px;">What other producers say</div>
      <div class="reviews-grid">
        {featured.map((r) => (
          <div class="review-card">
            <p class="review-quote">"{r.quote}"</p>
            <div>
              <div style="color:var(--accent); font-size:13px; letter-spacing:2px; margin-bottom:6px;">{stars(r.rating)}</div>
              <div class="mono" style="color:var(--ink-mute); font-size:11px;">{r.name.toUpperCase()}<br />{r.product.toUpperCase()}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Free packs CTA -->
    <section class="section" style="text-align:center; padding: 48px 0;">
      <div class="eyebrow" style="justify-content:center; margin-bottom: 16px;">Free · Lead with sound</div>
      <h2 style="margin-bottom: 20px;">Start with the free packs.</h2>
      <p style="max-width: 460px; margin: 0 auto 28px; color: var(--ink-soft); font-size: 17px;">
        Free sample packs, presets and a chords &amp; progressions PDF — no strings,
        just sounds to get you going.
      </p>
      <a class="btn accent" href={freePacksUrl} rel="noopener" style="display:inline-flex;">
        Get all free packs <span class="arrow">→</span>
      </a>
    </section>
  </div>

  <style>
    .shop-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 24px; align-items: stretch; }
    .shop-grid article { display: flex; flex-direction: column; }
    .prod-info { padding-top:14px; display:flex; justify-content:space-between; gap:12px; flex:1 0 auto; margin-bottom:14px; }
    .prod-title { font-family:var(--font-body); font-weight:600; font-size:20px; letter-spacing:-0.01em; line-height:1.15; }    @media (max-width: 1000px) { .shop-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .shop-grid { grid-template-columns: 1fr; } }
    .btn { display: inline-flex; }
    .reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .review-card {
      border: 1px solid var(--rule); padding: 24px;
      display: flex; flex-direction: column; justify-content: space-between;
      min-height: 200px;
    }
    .review-quote { font-size: 16px; line-height: 1.5; margin: 0 0 20px; }
    @media (max-width: 900px) { .reviews-grid { grid-template-columns: 1fr; } }
  </style>
</Base>
