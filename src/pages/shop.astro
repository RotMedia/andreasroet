---
import Base from '../layouts/Base.astro';
import productsData from '../data/products.json';

const products = productsData.products;

const shopLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Andreas Roet — Sample Packs & Presets',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.title,
      description: p.sub,
      url: p.url,
      ...(p.cover ? { image: p.cover } : {}),
      offers: {
        '@type': 'Offer',
        price: String(p.price).replace(/[^0-9.,]/g, ''),
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: p.checkoutUrl,
      },
      brand: { '@type': 'Brand', name: 'TechnoSupps' },
    },
  })),
};
---
<Base
  title="Shop — Dub Techno Sample Packs & Presets | Andreas Roet"
  description="Dub techno sample packs, chord presets and producer tools. Recorded with real hardware chains. Royalty-free, instant download via Gumroad."
  activeNav="shop"
  mode="dark"
  jsonLd={shopLd}
>
  <div class="page app">
    <section style="padding: 40px 0 24px;">
      <div class="eyebrow" style="margin-bottom: 16px;">Shop</div>
      <h1 style="max-width: 14ch; margin-bottom: 24px;">Tools<br />from the studio.</h1>
      <div class="row" style="gap: 40px; flex-wrap: wrap;">
        <p style="max-width: 520px; color: var(--ink-soft); font-size: 17px;">
          Sample packs and presets recorded with the same chains I use on my own records.
          Royalty-free. Checkout via Gumroad — instant download.
        </p>
        <div class="mono" style="display:grid; grid-template-columns:auto auto; gap:4px 24px;">
          <span style="color:var(--ink-mute)">PACKS</span><span>{products.length}</span>
          <span style="color:var(--ink-mute)">LICENSE</span><span>Royalty-free</span>
          <span style="color:var(--ink-mute)">CHECKOUT</span><span>Gumroad</span>
        </div>
      </div>
    </section>

    <div class="row middle" style="gap:0; padding:14px 0; border-top:1px solid var(--rule-strong); border-bottom:1px solid var(--rule-strong);">
      <span class="mono" style="color:var(--ink-mute);">{products.length} ITEMS</span>
      <span class="grow"></span>
      <span class="mono" style="color:var(--ink-mute);">SECURE CHECKOUT VIA GUMROAD ↗</span>
    </div>

    <section class="shop-grid" style="padding: 32px 0 56px;">
      {products.map((p) => (
        <article>
          <a href={p.url} rel="noopener" style="text-decoration:none; color:inherit;">
            <div class="imgbox cover" style="aspect-ratio:1/1; position:relative;">
              {p.cover
                ? <img src={p.cover} alt={`${p.title} — ${p.sub}`} loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" />
                : <div class="placeholder" style="position:absolute; inset:0;"><span style="font-size:12px;">{p.cat}</span></div>}
              {p.new && (
                <span style="position:absolute; top:12px; left:12px; z-index:2; background:var(--accent); color:var(--accent-ink); padding:4px 8px; font-family:var(--font-mono); font-size:10px; letter-spacing:0.08em;">NEW · OUT NOW</span>
              )}
            </div>
          </a>
          <div style="padding-top:14px; display:flex; justify-content:space-between; gap:12px;">
            <div>
              <div class="mono" style="margin-bottom:6px;">{p.cat}</div>
              <div style="font-family:var(--font-display); font-weight:800; font-size:26px; letter-spacing:-0.022em; line-height:1;">{p.title}</div>
              <div style="margin-top:6px; font-size:13px; color:var(--ink-soft);">{p.sub}</div>
            </div>
            <div style="text-align:right;">
              <div class="mono" style="font-size:14px;">{p.price}</div>
              <div class="mono" style="color:var(--ink-mute); margin-top:4px;">{p.fmt}</div>
            </div>
          </div>
          <a class="btn accent" href={p.checkoutUrl} rel="noopener" style="margin-top:14px; width:100%; justify-content:center;">
            Get it — checkout on Gumroad <span class="arrow">→</span>
          </a>
        </article>
      ))}
    </section>
  </div>

  <style>
    .shop-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 24px; }
    @media (max-width: 1000px) { .shop-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .shop-grid { grid-template-columns: 1fr; } }
    .btn { display: inline-flex; }
  </style>
</Base>
