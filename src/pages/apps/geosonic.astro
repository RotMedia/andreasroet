---
import Base from '../../layouts/Base.astro';
const APP = {
  name: 'GeoSonic', badge: 'Free · browser tool',
  tagline: 'Geometric MIDI Generator',
  url: '/geosonic/',
  cover: '/covers/tool-geosonic.webp',
  video: null,
};
const benefits = [
  ['Tedious programming is skipped.', 'Complex, organic-feeling rhythms are created in seconds instead of being tapped in step by step.'],
  ['Micro-timing is handled automatically.', 'Small timing shifts and swing are generated by the underlying math, so patterns feel human rather than mechanical — without a single knob being touched.'],
  ['Both software and hardware are supported.', 'Patterns can be previewed in the browser, sent live to a DAW or hardware synth over MIDI, or exported as a standard .mid file.'],
  ['New ideas are discovered, not just executed.', 'Because the shapes are played with rather than programmed, patterns turn up that wouldn\u2019t have been thought of by hand.'],
  ['Nothing is locked away.', 'Free, runs entirely in the browser, and stays exactly the way it is — no subscription, no expiring trial.'],
];
const algos = [
  ['Euclidean', 'Beats are distributed as evenly as possible around a circle, the same way traditional rhythms from around the world are built — from four-on-the-floor to complex polyrhythms.'],
  ['Fibonacci Spiral', 'A pattern generated from the golden spiral. Because the underlying ratio is irrational, it never exactly repeats — a rhythm that keeps quietly evolving instead of looping.'],
  ['Prime Phase', 'Multiple loops layered, each with a length based on a prime number. The layers drift in and out of phase; full realignment only arrives after many bars.'],
  ['Cellular Automaton', 'A row of on/off cells evolved bar by bar by a simple rule — the same kind behind the Sierpi\u0144ski triangle. A pattern is grown rather than written.'],
  ['Lorenz Attractor', 'A chaotic system — the one behind the butterfly effect — generating smooth, ever-changing modulation instead of notes. Filters and sends move continuously, never repeating.'],
  ['L-System', 'A sequence grown by rewriting a short phrase over and over, the principle used to model how plants branch. Long, self-similar rhythms from a couple of symbols.'],
  ['Metatron (Platonic Solid)', 'A rotating 3D solid projected onto a circle of steps. As it spins, corners sweep past the circle and trigger notes — a melody generator built from a spinning object.'],
  ['Radial Fibonacci', 'A spiral drawn from the Fibonacci sequence, each ring with its own timing and pitch. Played inside out, outside in, or back and forth.'],
];
---
<Base title={`${APP.name} — Free MIDI Tool for Producers | Andreas Roet`}
      description="GeoSonic turns mathematical patterns into MIDI. Free, browser-based, no install. Eight algorithms from Euclidean rhythms to Lorenz attractors."
      activeNav="apps" mode="dark">
  <div class="page app">
    <section style="padding:40px 0 24px;">
      <div class="eyebrow" style="margin-bottom:16px;">Apps · {APP.badge}</div>
      <h1 style="margin-bottom:20px;">{APP.name}.</h1>
      <p style="font-size:20px; color:var(--ink-soft); max-width:560px; margin-bottom:28px;">{APP.tagline}</p>
    </section>

    <section class="section" style="border-top:0; padding-top:0;">
      <div class="app-intro">
        <div class="app-shot">
          {APP.video
            ? <video src={APP.video} poster={APP.cover} autoplay muted loop playsinline></video>
            : <img src={APP.cover} alt={`${APP.name} interface`} loading="lazy" />}
        </div>
        <div class="app-copy">
          <p class="app-p">Traditional step sequencers are built around a grid, with every note placed by hand. GeoSonic flips that: a mathematical structure — a spiral, a rotating solid, a self-repeating pattern — is chosen, and rhythm, melody and timing are generated from its shape. Nothing is randomized. Every note traces back to a real mathematical property, so patterns can be explored, tweaked, and trusted to make musical sense.</p>
          <div class="app-note"><p><strong>Browser note:</strong> MIDI output to hardware works in Chrome and Edge. Firefox needs an extra add-on for Web MIDI — the built-in preview synth and .mid export work everywhere.</p></div>
          <a class="btn accent" href={APP.url} target="_blank" rel="noopener" style="align-self:flex-start;">Try {APP.name} now <span class="arrow">→</span></a>
        </div>
      </div>
    </section>


    <section class="section">
      <div class="eyebrow" style="margin-bottom:24px;">What it's good for</div>
      <div class="feat-grid">
        {benefits.map(([h, t]) => (
          <div class="feat">
            <h3 style="font-size:18px; margin:0 0 8px;">{h}</h3>
            <p style="font-size:14px; color:var(--ink-soft); margin:0; line-height:1.55;">{t}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="eyebrow" style="margin-bottom:12px;">The algorithms</div>
      <p style="color:var(--ink-soft); font-size:15px; max-width:620px; margin-bottom:24px;">
        Eight modes, each based on a different mathematical idea — with a signature colour so the current algorithm is recognised at a glance.
      </p>
      {algos.map(([n, d]) => (
        <div class="algo-row">
          <div class="mono algo-name">{n}</div>
          <div class="algo-desc">{d}</div>
        </div>
      ))}
    </section>

    <section class="section" style="text-align:center; padding:40px 0;">
      <p class="mono" style="color:var(--ink-mute); margin-bottom:20px;">Built for producers who'd rather explore a shape than program a grid.</p>
    </section>
  </div>

  <style>
    .app-intro { display:grid; grid-template-columns: 1.1fr 1fr; gap:32px; align-items:start; }
    .app-shot img, .app-shot video { width:100%; border:1px solid var(--rule); display:block; }
    .app-copy { display:flex; flex-direction:column; }
    .app-p { font-size:15px; line-height:1.6; color:var(--ink-soft); margin:0 0 14px; }
    .app-note { border-left:3px solid var(--accent); padding:12px 16px; margin:4px 0 18px; }
    .app-note p { font-size:14px; line-height:1.55; margin:0; color:var(--ink-soft); }
    @media (max-width:900px){ .app-intro{ grid-template-columns:1fr; gap:20px; } }
    .feat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
    .feat { border:1px solid var(--rule); padding:20px; }
    .algo-row { display:grid; grid-template-columns:200px 1fr; gap:24px; padding:16px 0; border-bottom:1px solid var(--rule); }
    .algo-row:last-child { border-bottom:0; }
    .algo-name { color:var(--accent); font-size:13px; padding-top:2px; }
    .algo-desc { font-size:15px; color:var(--ink-soft); line-height:1.55; }
    @media (max-width:900px){ .feat-grid{grid-template-columns:1fr;} .algo-row{grid-template-columns:1fr; gap:6px;} }
  </style>
</Base>
