---
import Base from '../layouts/Base.astro';
---
<Base title="404 | Andreas Roet" description="Page not found.">
  <div class="page app">
    <section style="padding: 80px 0 120px;">
      <div class="eyebrow" style="margin-bottom: 16px;">Error 404</div>
      <h1>Signal lost.</h1>
      <p style="margin-top: 24px; color: var(--ink-soft);">This page doesn't exist.</p>
      <a class="btn ghost" href="/" style="margin-top: 32px; display: inline-flex;">Back to index <span class="arrow">→</span></a>
    </section>
  </div>
</Base>
