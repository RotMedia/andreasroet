---
import Base from '../layouts/Base.astro';
const DISCORD = 'https://discord.gg/vXDSCJwPN';
---
<Base
  title="Join the Dub Techno Outpost — Community | Andreas Roet"
  description="The Dub Techno Outpost — an open community for open and like-minded producers. Home for TechnoSupps product owners. We share knowledge through challenges, not consume-and-forget."
  activeNav=""
  mode="dark"
>
  <div class="page app">
    <section class="outpost-hero">
      <div class="outpost-hero-inner">
        <div class="row" style="align-items:center; gap:14px; margin-bottom:20px;">
          <svg width="30" height="23" viewBox="0 0 127.14 96.36" fill="#e4e2dd" aria-hidden="true"><path d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z"/></svg>
          <div class="eyebrow" style="margin:0;">Community · Discord</div>
        </div>
        <h1 style="margin:0;">Join the<br />Dub Techno Outpost.</h1>
      </div>
    </section>

    <section class="section" style="border-top:0; padding-top:28px; max-width:760px;">
      <p style="font-size: 20px; line-height: 1.5; color: var(--ink-soft); margin-bottom: 28px; max-width: 620px;">
        A free community for open and like-minded producers.
      </p>

      <div class="about-benefit" style="margin: 0 0 36px;">
        <p style="font-size: 17px; line-height: 1.6; margin: 0 0 14px;">
          We share knowledge through challenges instead of consume-and-forget —
          building skills together, not just collecting tutorials.
        </p>
        <p style="font-size: 17px; line-height: 1.6; margin: 0;">
          Home for TechnoSupplements product owners.
        </p>
      </div>

      <a class="btn accent" href={DISCORD} target="_blank" rel="noopener" style="display:inline-flex;">
        Join the Dub Techno Outpost — free <span class="arrow">→</span>
      </a>
    </section>
  </div>

  <style>
    .outpost-hero {
      position: relative; overflow: hidden;
      border-radius: 14px; margin-top: 24px;
      background: url('/covers/outpost-banner.webp') center 78%/cover no-repeat;
      min-height: clamp(280px, 34vw, 440px);
      display: flex; align-items: flex-end;
    }
    .outpost-hero::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(20,20,18,.25) 0%, rgba(20,20,18,.55) 55%, rgba(20,20,18,.88) 100%);
    }
    .outpost-hero-inner { position: relative; z-index: 1; padding: 32px clamp(20px, 4vw, 44px) 30px; }
    .outpost-hero h1 { color: #e4e2dd; }
    .outpost-hero .eyebrow { color: #e4e2dd; }
  </style>
</Base>
