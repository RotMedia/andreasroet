---
import Base from '../layouts/Base.astro';
import toolsData from '../data/tools.json';
const tools = toolsData.tools;
---
<Base
  title="Tools — Producer Tools for Dub Techno | Andreas Roet"
  description="Special tools for your studio sessions — creative and workflow tools for dub techno and techno producers. GeoSonic, Live Set Planner and more."
  activeNav="tools"
  mode="dark"
>
  <div class="page app">
    <section style="padding: 40px 0 24px;">
      <div class="eyebrow" style="margin-bottom: 16px;">Tools</div>
      <h1 style="max-width: 14ch; margin-bottom: 24px;">Special tools<br />for the studio.</h1>
      <p style="max-width: 480px; color: var(--ink-soft); font-size: 17px;">
        Special tools for your studio sessions — small, focused, made to fit the
        way producers actually work.
      </p>
    </section>

    <section class="tools-grid" style="padding: 24px 0 56px;">
      {tools.map((t) => (
        <article class="tool-card">
          <a href={t.status === 'coming-soon' ? `/tools/${t.id}` : t.url}
             target={t.url && t.url.startsWith('http') ? '_blank' : undefined}
             rel={t.url && t.url.startsWith('http') ? 'noopener' : undefined}
             style="text-decoration:none; color:inherit; display:block;">
            <div class="imgbox cover" style="aspect-ratio:16/10; position:relative;">
              {t.cover
                ? <img src={t.cover} alt={t.name} loading="lazy" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;" />
                : <div class="placeholder" style="position:absolute; inset:0;"><span class="mono" style="font-size:12px;">{t.name.toUpperCase()}</span></div>}
              {t.status === 'coming-soon' && (
                <span class="tool-badge">Coming soon</span>
              )}
              {t.status === 'free' && (
                <span class="tool-badge">Free</span>
              )}
            </div>
            <div style="padding-top:16px;">
              <div class="mono" style="color:var(--ink-mute); margin-bottom:8px;">{t.sub}</div>
              <div style="font-family:var(--font-display); font-size:28px; line-height:1; margin-bottom:8px;">{t.name}</div>
              <p style="font-size:14px; color:var(--ink-soft); margin:0;">{t.tagline}</p>
            </div>
          </a>
          <div style="padding-top:16px;">
            {t.status === 'free' && (
              <a class="btn accent" href={t.url} target={t.url.startsWith('http') ? '_blank' : undefined} rel={t.url.startsWith('http') ? 'noopener' : undefined} style="width:100%; justify-content:center;">Try {t.name} now <span class="arrow">→</span></a>
            )}
            {t.status === 'coming-soon' && (
              <a class="btn ghost" href={`/tools/${t.id}`} style="width:100%; justify-content:center;">Learn more & join waitlist <span class="arrow">→</span></a>
            )}
          </div>
        </article>
      ))}
    </section>
  </div>

  <style>
    .tools-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 24px; }
    @media (max-width: 900px) { .tools-grid { grid-template-columns: 1fr; } }
    .tool-badge {
      position:absolute; top:12px; left:12px; z-index:2;
      background:var(--accent); color:var(--accent-ink);
      padding:4px 8px; font-family:var(--font-mono); font-size:10px; letter-spacing:0.08em;
    }
    .btn { display:inline-flex; }
  </style>
</Base>
